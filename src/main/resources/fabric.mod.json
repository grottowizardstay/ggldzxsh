{
	"schemaVersion": 1,
	"id": "kalabushkin_gym",
	"version": "${version}",
	"name": "Legends of Seltso: Gym (dev add-on)",
	"description": "Development-only wrapper. The release jar merges this into Legends of Seltso; see release/fabric.mod.json.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.kalabushkin.gym.GymMod",
			"com.kalabushkin.town.TownMod"
		],
		"client": [
			"com.kalabushkin.gym.client.GymClient",
			"com.kalabushkin.town.client.TownClient"
		]
	},
	"mixins": [
		"kalabushkin_gym.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"kalabushkin": "*"
	}
}
